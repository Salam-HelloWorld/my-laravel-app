# Copy this file to `.env` for local development:
#   cp .env.example .env && php artisan key:generate
# On Render, add the same keys under: Service -> Environment -> Environment Variables.
# NEVER commit `.env` (it is in .gitignore). Only this example file goes to git.

APP_NAME="Laravel Template"
APP_ENV=local
# Generate one with:  php artisan key:generate --show   (Render needs its own APP_KEY!)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Custom template settings
APP_VERSION=0.1.0
WELCOME_MESSAGE="Hello from Laravel!"
# A secret value. The app only reports whether it is set, it never prints it.
API_SECRET=change-me

# Render sets PORT automatically (the Docker container listens on it). Locally `php artisan serve` uses 8000.
# PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ---- No database in this template ----
# Everything that Laravel normally keeps in a database is switched to files / memory.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file
MAIL_MAILER=log
